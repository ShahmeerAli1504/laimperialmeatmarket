# Copy to .env.local (local dev) and add the same keys in Vercel → Project → Settings → Environment Variables.

# ---- SEO ----
# Public production URL (no trailing slash). Used for canonical tags, sitemap.xml, robots.txt,
# Open Graph and JSON-LD. On Vercel it falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---- Gmail SMTP (contact form emails) ----
# GMAIL_USER is the Gmail / Google Workspace address that sends the email.
# GMAIL_APP_PASSWORD is a 16-character App Password (Google Account → Security →
# 2-Step Verification → App passwords). A normal Gmail password will NOT work.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where contact-form messages are delivered (comma-separate several). Defaults to GMAIL_USER.
CONTACT_TO_EMAIL=

# ---- Supabase (stores every contact-form message) ----
# Project Settings → API. The service-role key is server-only — never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
